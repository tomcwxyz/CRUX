# CRUX pilot GitHub App connection
#
# Register a GitHub App and configure:
# Callback URL: https://crux-ashy.vercel.app/api/github/callback
# Setup URL:    https://crux-ashy.vercel.app/api/github/installed
#
# Repository permissions for the discovery pilot:
# - Metadata: read
# - Contents: read
#
# No write permission is needed for repository discovery.

GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_CONNECTION_SECRET=
